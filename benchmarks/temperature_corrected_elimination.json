{
  "name": "temperature_corrected_elimination",
  "goal": "Temperature-corrected drug elimination (one-compartment + Arrhenius).",
  "given": {
    "C0": "mg/L - initial concentration",
    "t": "h - time",
    "T": "K - body temperature",
    "A": "1/h - Arrhenius pre-exponential factor",
    "Ea": "J/mol - activation energy",
    "R": "J/(mol*K) - gas constant"
  },
  "unknowns": ["C"],
  "assumptions": ["C0>0", "t>=0", "T>0", "Ea>0"],
  "base_formulas": ["C = C0*exp(-k*t)", "k = A*exp(-Ea/(R*T))"],
  "modifications": [],
  "expected": "C0*exp(-A*t*exp(-Ea/(R*T)))"
}
